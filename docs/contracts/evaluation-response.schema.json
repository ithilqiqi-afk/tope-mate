{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "Evaluation response candidate v0.1",
  "type": "object",
  "required": [
    "success",
    "scores",
    "strengths",
    "weaknesses",
    "suggestions",
    "evidence",
    "peel",
    "improvedExpressions"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "scores": {
      "type": "object",
      "required": [
        "overall",
        "dimensions"
      ],
      "properties": {
        "overall": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quote",
          "comment"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "comment": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string"
          }
        }
      }
    },
    "peel": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "point": {
              "type": [
                "string",
                "null"
              ]
            },
            "explain": {
              "type": [
                "string",
                "null"
              ]
            },
            "example": {
              "type": [
                "string",
                "null"
              ]
            },
            "link": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "improvedExpressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original",
          "improved"
        ],
        "properties": {
          "original": {
            "type": "string"
          },
          "improved": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "notAssessed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "const": "0.1.0"
    }
  }
}
