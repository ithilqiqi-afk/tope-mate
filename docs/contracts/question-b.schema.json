{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "TOPE B set (A-compatible candidate)",
  "type": "object",
  "required": [
    "id",
    "cat",
    "topic",
    "topicZh",
    "cards",
    "discussion",
    "discussionZh",
    "followUps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "cat": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "topicZh": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "key",
          "point",
          "pointZh"
        ],
        "properties": {
          "key": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "point": {
            "type": "string",
            "minLength": 1
          },
          "pointZh": {
            "type": "string"
          },
          "image": {
            "type": "object",
            "required": [
              "src",
              "alt"
            ],
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "credit": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "discussion": {
      "type": "string",
      "minLength": 1
    },
    "discussionZh": {
      "type": "string"
    },
    "followUps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "key",
          "q"
        ],
        "properties": {
          "key": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "q": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "presentationSeconds": {
      "enum": [
        90,
        120
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exam_recollection",
            "classroom_sample",
            "practice",
            "ai_generated",
            "unknown"
          ]
        },
        "reference": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "verified"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
