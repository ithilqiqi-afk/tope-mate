# TOPE Mate · 语音转写服务环境变量示例
# 复制成同目录下的 .env 再填真实值；.env 已被 .gitignore 排除，不要提交、不要截图外传。
# 只在本机使用：服务只监听 127.0.0.1，本轮不把它部署到公网。
# 所有值都只写 ASCII（英文、数字与符号），中文注释可以保留。

# ── 用哪家转写服务 ───────────────────────────────────────────────
# openai（默认）或 bailian（阿里云百炼·华北2 北京）。写别的值服务会直接报错退出。
TRANSCRIBE_PROVIDER=

# 转写用的 API Key。没有 Key 时服务照常启动，但 /api/transcribe 返回 503，
# 前端只会显示失败原因，不会编造任何转写文本。
OPENAI_API_KEY=

# 端口必须与 config/exam-config.js 里 services.transcribeEndpoint / healthEndpoints.transcribe 一致。
PORT=3002

# 模型名，留空用服务内置默认（src/provider.mjs 的 DEFAULT_MODEL）。
TRANSCRIBE_MODEL=

# 转写提示词，留空用服务内置默认；只在服务端使用，不会出现在前端。
TRANSCRIBE_PROMPT=

# 单次转写的超时毫秒数（留空用默认 90000）与请求体上限字节数（默认 12 MB，与前端 services/transcription.js 的上限同口径）。
# 前端 config/exam-config.js 的 requestTimeoutMs.transcribe 现为 120000，必须保持「前端 > 服务端」。
TRANSCRIBE_TIMEOUT_MS=
MAX_AUDIO_BYTES=

# ── 阿里云百炼（TRANSCRIBE_PROVIDER=bailian 时才需要） ────────────────
# 百炼 Key：填控制台上生成的那一串，绝不要填 OpenAI 的 Key。
# 两个供应商的 Key 互不回退：选了 bailian 却没填这一行，/api/transcribe 返回 503 API_KEY_MISSING，
# 服务不会把 OPENAI_API_KEY 发给阿里云。
BAILIAN_API_KEY=
# 也可以用阿里云通用的变量名，两者填一个即可（同时填时以 BAILIAN_API_KEY 优先）。
DASHSCOPE_API_KEY=

# 服务地址。留空即用与评分服务同一个、已由成员 B 真实调用验证过的北京通用域名
#   https://dashscope.aliyuncs.com/compatible-mode/v1（无需业务空间 ID；ASR 本身还等第一次真实调用）
# 官方另推荐业务空间专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1，
# 需要更高性能时把 {WorkspaceId} 换成控制台「业务空间详情」里的真实 ID；不要提交真实 ID。
# 仍带 {WorkspaceId} 占位符或写成非 https 时，/api/transcribe 返回 503 PROVIDER_CONFIG_ERROR，不会发起任何调用。
# 官方文档：https://help.aliyun.com/zh/model-studio/ 下的 qwen-asr-api-reference
BAILIAN_BASE_URL=

# 转写模型 ID，留空用内置默认 qwen3-asr-flash。
# 官方口径（2026-11-21 核实）：华北2（北京）可用、支持英文、单次 1 个音频、时长 ≤5 分钟、Base64 编码后 ≤10 MB。
# qwen3-asr-flash 走 Chat Completions + input_audio（与评分用的 Responses 接口不是同一个），
# 格式表支持 webm/ogg/wav/mp3/flac，不含 m4a/mp4/mov —— Safari 录出来的 m4a 在这条通路上会返回 415，请改用 Chrome 或 Edge。
# 团队 Key 是否已开通本模型尚未验证：未开通会返回 PROVIDER_MODEL_UNAVAILABLE/PROVIDER_HTTP_ERROR，服务不会伪造转写文本。
BAILIAN_ASR_MODEL=

# 中文数字转大写（Inverse Text Normalization），默认 false；官方只对中文、英文生效。
BAILIAN_ASR_ENABLE_ITN=

# 说明：本服务不保存任何录音，日志只记方法、路径、状态、耗时与字节数；
# 单次音频受官方上限约束（Base64 编码后 ≤10 MB、时长 ≤5 分钟），超限直接报错，绝不截断当完整转写。
