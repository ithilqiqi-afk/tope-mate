# TOPE Mate · B 模块（AI 评分服务）环境变量示例
# 复制成同目录下的 .env 再填真实值；.env 已被 .gitignore 排除，不要提交、不要截图外传。
# 只在本机使用：服务默认只监听 127.0.0.1，不要把它暴露到公网。
# 所有值都只写 ASCII（英文、数字与符号），中文注释可以保留。

# ── 用哪家模型服务 ───────────────────────────────────────────────
# openai（默认）或 bailian（阿里云百炼·华北2 北京）。写别的值服务会直接报错退出。
SCORING_PROVIDER=

# 评分用的 API Key。留空时服务走离线文本启发式（mode=heuristic），前端不会显示练习分。
OPENAI_API_KEY=

# 端口必须与 config/exam-config.js 里 services.evaluateEndpoint 的端口一致。
PORT=3001

# 评分模式：服务默认是 heuristic（离线文本启发式，不调模型、不给练习分）。
# 想用真实模型评分，必须显式写 SCORING_MODE=ai；只填 Key 不填这一行，报告仍会显示离线启发式。
# SCORING_MODE 只接受 heuristic 或 ai，写成别的值服务会直接报错退出。
SCORING_MODE=

# 模型名，留空用 B 模块内置默认。
OPENAI_MODEL=

# 一次模型调用的超时毫秒数，留空用默认 120000（2 分钟）。
# 实测参考：百炼 qwen3.8-flash 非流式真实评分单次 59.09 秒（成员 B，2026-11-21），所以 45000 这类旧默认值会稳定超时。
# 前端 services/evaluation.js 还有一层总超时（config/exam-config.js 的 requestTimeoutMs.evaluate，现为 150000），
# 必须保持「前端 > 服务端」，否则浏览器会先静默中断，报告里只留下 timeout 而拿不到后端的真实错误码。
SCORING_TIMEOUT_MS=

# ── 阿里云百炼（SCORING_PROVIDER=bailian 时才需要） ─────────────────
# 百炼 Key：填控制台上生成的那一串，绝不要填 OpenAI 的 Key。
# 两个供应商的 Key 互不回退：选了 bailian 却没填这一行，/api/evaluate 返回 503 API_KEY_MISSING，
# 服务不会把 OPENAI_API_KEY 发给阿里云。
BAILIAN_API_KEY=
# 也可以用阿里云通用的变量名，两者填一个即可（同时填时以 BAILIAN_API_KEY 优先）。
DASHSCOPE_API_KEY=

# 服务地址。留空即用已经过真实调用验证的北京通用域名
#   https://dashscope.aliyuncs.com/compatible-mode/v1（无需业务空间 ID）
# 官方另推荐业务空间专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1，
# 需要更高性能时把 {WorkspaceId} 换成控制台「业务空间详情」里的真实 ID；不要提交真实 ID。
# 仍带 {WorkspaceId} 占位符或写成非 https 时，/api/evaluate 返回 503 PROVIDER_CONFIG_ERROR，且不会发起任何调用。
BAILIAN_BASE_URL=

# 评分接口：留空即 responses，由 provider.mjs 里成员 B 真实调用实测通过的默认实现处理
#   （嵌套 text.format.json_schema、max_output_tokens=16384、reasoning.effort=low）。
# 填 chat 才切到 bailian-provider.mjs 的非默认备用实现（Chat Completions，从未做过真实调用验证）。
# 两条通路共用同一套 Schema 1.4.0 校验与评分算法。
BAILIAN_SCORING_TRANSPORT=

# 思考强度档位：none / low / medium / high / xhigh。
# 【仅非默认备用通路生效】只有 bailian-provider.mjs 的 responses 分支会读它；
# 默认 responses 通路由 B 的实现固定 reasoning.effort=low，本变量填什么都不影响默认评分。
# 备用通路留空即不发送该参数（模型默认 xhigh）；改档位会改变输出风格，必须重新做真实验收再用于演示。
BAILIAN_SCORING_REASONING_EFFORT=

# 评分模型 ID，留空用内置默认 qwen3.8-flash（Responses 与 Chat 两条接口的官方支持列表里都有它）。
# 换成其他模型前，请先确认它同样支持结构化输出，且已在你这个业务空间里开通。
BAILIAN_MODEL=

# 【仅非默认备用通路生效】chat 备用通路专用：qwen3.8-flash 默认开启思考模式，
# 备用实现默认显式发送 enable_thinking=false 以更快返回。
# 默认 responses 通路不看这一项，思考强度由 B 的实现固定为 reasoning.effort=low。
# 需要思考过程时改成 true（会更慢、更贵），不要在本机以外打开。
BAILIAN_ENABLE_THINKING=

# 输出长度上限：默认 responses 通路按 B 的实测报文发送 max_output_tokens=16384（Qwen3.8 思维链计入上限）；
# 备用 chat 通路按官方要求不发送 max_tokens；备用 responses 分支发送 3600。
# 模型输出被截断时（chat 的 finish_reason=length 或 responses 的 status=incomplete）
# 返回 PROVIDER_INCOMPLETE，前端显示评分失败，不会给出半份分数。
# responses 通路固定发送 store=false：不让百炼保存本次会话与转写原文。
