{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "title": "Evaluation request candidate v0.1",
  "type": "object",
  "required": [
    "examType",
    "question",
    "stage",
    "transcript",
    "durationSeconds",
    "rubric"
  ],
  "properties": {
    "examType": {
      "enum": [
        "B",
        "C"
      ]
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "candidateKey": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "discussion": {
          "type": "string"
        }
      }
    },
    "stage": {
      "enum": [
        "intro",
        "presentation",
        "discussion",
        "speech",
        "qa"
      ]
    },
    "transcript": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "rubric": {
      "type": "object"
    }
  }
}
